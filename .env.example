# Conexão com o PostgreSQL.
# Local: postgresql://USUARIO:SENHA@localhost:5432/estante
# Neon (Netlify): use a URL com pooling, cujo host termina em "-pooler", com ?sslmode=require
DATABASE_URL=""

# Senha que criptografa o cookie de sessão, com pelo menos 32 caracteres.
# Gere com: openssl rand -base64 48
SESSION_SECRET=""
